    </section>

    <section aria-labelledby="experienta-mobil">
      <h2 id="experienta-mobil" class="text-2xl font-bold mb-4" style="color: #00d4ff;">
        Experiență live casino optimizată pentru accesul de pe mobil
      </h2>

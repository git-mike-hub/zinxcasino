---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Banner from '../components/Banner.astro';
import HeroCTA from '../components/HeroCTA.astro';
import Footer from '../components/Footer.astro';
import { buildPageSchema } from '../lib/schemas/page';
import { DEFAULT_OG_IMAGE } from '../lib/seo';

const schema = buildPageSchema({
  name: 'Experimentează live cazino la tine acasă - Zinxcasino.ro',
  description:
    'Află cum este experiența la mesele live casino Zinx când joci pe PC sau mobil. Descoperă categorii de jocuri și promoții la ruletă, baccarat și blackjack live.',
  path: '/cazino-live',
  keywords: ['cazino live zinx', 'zinx casino live', 'ruletă live zinx', 'blackjack live zinx'],
});
---

<BaseLayout
  title="Experimentează live cazino la tine acasă - Zinxcasino.ro"
  description="Află cum este experiența la mesele live casino Zinx când joci pe PC sau mobil. Descoperă categorii de jocuri și promoții la ruletă, baccarat și blackjack live."
  schema={schema}
  ogImage={DEFAULT_OG_IMAGE}
  ogImageAlt="Cazino Live Zinx Casino"
>
  <Header slot="header" />
  <HeroCTA title="Zinx casino live: blackjack, zaruri, ruletă și baccarat cu dealeri reali" />
  <Banner />

  <main id="continut-principal" class="max-w-4xl mx-auto px-4 py-12 space-y-16">
    <section aria-labelledby="intro-cazino-live">
      <div class="space-y-5 text-gray-300 leading-relaxed">
        <p>
          Mesele live online reprezintă alternativa ideală pentru jucătorii care nu pot ajunge într-un cazinou fizic. <a href="/" class="underline" style="color: #a78bfa;">Zinx casino</a> le oferă acces jucătorilor la sesiuni de joc în timp real, fără descărcare, cu transmisiuni la rezoluții

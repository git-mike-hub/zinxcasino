  </main>

  <Footer />

  <script is:inline>
    document.getElementById('zinx-intro-video')?.addEventListener(
      'click',
      () => {
        const container = document.getElementById('zinx-intro-video');
        if (!container || container.querySelector('iframe')) return;

        const iframe = document.createElement('iframe');
        iframe.className = 'h-full w-full';
        iframe.src = 'https://www.youtube.com/embed/7NWMrDfSYcE?rel=0&modestbranding=1&autoplay=1';
        iframe.title = 'Prezentare Zinx Casino';
        iframe.referrerPolicy = 'strict-origin-when-cross-origin';
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;

        container.replaceChildren(iframe);
      },
      { once: true },
    );
  </script>

</BaseLayout>
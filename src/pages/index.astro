    <section aria-labelledby="inregistrare">
      <h2 id="inregistrare" class="text-2xl font-bold mb-4" style="color: #00d4ff;">
        Înregistrează-te și joacă la casino Zinx România!
      </h2>
      <p class="text-gray-300 leading-relaxed">

              <td class="py-3 px-4 text-white">Premii în monede Zinx</td>
            </tr>
            <tr style="border-bottom: 1px solid #1a1a3e;">
              <td class="py-3 px-4 text-gray-400">Magazinul de bonusuri</td>
              <td class="py-3 px-4 text-white">Bonusuri cash, rotiri gratuite, jocuri bonus și pariuri gratuite</td>
            </tr>
            <tr style="border-bottom: 1px solid #1a1a3e;">
              <td class="py-3 px-4 text-gray-400">Turnee</td>
              <td class="py-3 px-4 text-white">Cazino live, Cursa Lunară, Jocul Slot al Săptămânii și Drops &amp; Wins</td>
            </tr>
            <tr>

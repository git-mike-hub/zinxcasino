---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Banner from '../components/Banner.astro';
import HeroCTA from '../components/HeroCTA.astro';
import Footer from '../components/Footer.astro';
import { buildPageSchema } from '../lib/schemas/page';
import { DEFAULT_OG_IMAGE } from '../lib/seo';

const schema = buildPageSchema({
  name: 'Sloturi Online și Păcănele la Zinx Casino',
  description:
    'Sloturi și păcănele online la Zinx Casino: jocuri populare, jackpoturi, RTP, volatilitate, bonusuri și acces pe mobil.',

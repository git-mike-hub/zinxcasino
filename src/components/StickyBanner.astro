<div id="sticky-banner" class="sticky-banner">
  <a
    href="https://zinx.ro/ro/"
    target="_blank"
    rel="noopener noreferrer sponsored"
    class="sticky-banner__link"
    aria-label="Deschide oferta Zinx Casino"
  >
    <img
      src="/images/zinx-sticky-banner.png"
      alt="Zinx Casino - bonus pana la 5.000 RON"
      class="sticky-banner__image"
      loading="eager"
      fetchpriority="high"
    />
  </a>

  <button id="sticky-banner-close" type="button" class="sticky-banner__close" aria-label="Inchide bannerul">
    &times;
  </button>
</div>

<script is:inline>
  const stickyBanner = document.getElementById('sticky-banner');
  const stickyBannerClose = document.getElementById('sticky-banner-close');

  if (stickyBanner && stickyBannerClose) {
    document.body.classList.add('has-sticky-banner');

    stickyBannerClose.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();
      stickyBanner.remove();
      document.body.classList.remove('has-sticky-banner');
    });
  }
</script>

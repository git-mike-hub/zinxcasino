---
const CTA_URL = 'https://zinx.ro/ro?utm_source=zinxcasino&utm_medium=hero&utm_campaign=register';
---

<div class="hero-cta">
  <div class="hero-cta__content">
    <span class="hero-cta__badge">
      <span class="hero-cta__badge-text">Bonus de bun venit</span>
    </span>

    <p class="hero-cta__headline">
      100% PÂNĂ LA 5,000 RON
      <br />
      + 500 ROTIRI GRATUITE
    </p>

    <a
      href={CTA_URL}
      rel="noopener noreferrer sponsored"
      target="_blank"
      class="hero-cta__button"
    >
      ÎNSCRIE-TE ACUM
    </a>
  </div>
</div>

<style>
  .hero-cta {
    position: absolute;
    z-index: 5;
    bottom: 1.75rem;
    left: 50%;
    width: min(92%, 22rem);
    transform: translateX(-50%);
    pointer-events: none;
  }

  .hero-cta__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-cta__badge,
  .hero-cta__headline,
  .hero-cta__button {
    pointer-events: auto;
  }

  .hero-cta__badge {
    display: inline-block;
    margin-bottom: 0.75rem;
    background: linear-gradient(180deg, #ff6b2c 0%, #f04a12 100%);
    padding: 0.2rem 0.9rem;
    transform: skewX(-14deg);
    box-shadow: 0 4px 14px rgba(240, 74, 18, 0.45);
  }

  .hero-cta__badge-text {
    display: inline-block;
    transform: skewX(14deg);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 800;
    font-style: italic;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .hero-cta__headline {
    margin: 0;
    color: #fff;
    font-size: clamp(1.35rem, 5.2vw, 1.85rem);
    font-weight: 900;
    font-style: italic;
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    text-shadow:
      0 0 18px rgba(255, 255, 255, 0.35),
      0 0 32px rgba(120, 210, 255, 0.25),
      0 2px 8px rgba(0, 0, 0, 0.55);
  }

  .hero-cta__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 1.375rem;
    min-width: 13.5rem;
    padding: 0.8rem 1.75rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: linear-gradient(180deg, #ff7a32 0%, #f04a12 55%, #d93d0a 100%);
    color: #fff;
    font-size: 0.95rem;
    font-weight: 900;
    font-style: italic;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    animation: hero-cta-pulse 2.6s ease-in-out infinite;
    box-shadow:
      0 0 14px rgba(255, 120, 60, 0.65),
      0 0 28px rgba(0, 212, 255, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.35);
  }

  .hero-cta__button:hover {
    transform: scale(1.06);
    animation: none;
    box-shadow:
      0 0 22px rgba(255, 140, 80, 0.95),
      0 0 42px rgba(0, 212, 255, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.45);
  }

  @media (min-width: 768px) {
    .hero-cta {
      bottom: auto;
      left: 0;
      right: 0;
      top: 54%;
      width: 100%;
      transform: translateY(-50%);
    }

    .hero-cta__content {
      width: 100%;
      max-width: 72rem;
      margin: 0 auto;
      padding-left: 4rem;
      align-items: flex-start;
      text-align: left;
    }

    .hero-cta__badge {
      margin-bottom: 0.875rem;
    }

    .hero-cta__badge-text {
      font-size: 0.82rem;
    }

    .hero-cta__headline {
      font-size: clamp(1.65rem, 2.4vw, 2.35rem);
    }

    .hero-cta__button {
      font-size: 1.05rem;
      min-width: 15rem;
      margin-top: 1.5rem;
      padding: 0.9rem 2rem;
    }
  }

  @keyframes hero-cta-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow:
        0 0 12px rgba(255, 120, 60, 0.55),
        0 0 24px rgba(0, 212, 255, 0.3),
        inset 0 1px 0 rgba(255, 255, 255, 0.3);
    }

    50% {
      transform: scale(1.03);
      box-shadow:
        0 0 22px rgba(255, 140, 80, 0.9),
        0 0 40px rgba(0, 212, 255, 0.5),
        inset 0 1px 0 rgba(255, 255, 255, 0.4);
    }
  }
</style>

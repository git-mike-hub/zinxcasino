---
const { title = "Zinx Casino România" } = Astro.props;
---

<div
  class="w-full text-center px-4 py-10"
  style="background: linear-gradient(135deg, #0a0a0f 0%, #1a0a3e 50%, #0a0a0f 100%);"
>
  <h1 class="text-4xl md:text-6xl font-extrabold text-center">
    <span style="background: linear-gradient(90deg, #00d4ff, #7b2ff7); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
      {title}
    </span>
  </h1>
</div>
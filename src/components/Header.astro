---
const CTA_URL = 'https://zinx.ro?utm_source=zinxcasino&utm_medium=header&utm_campaign=register';
const navLinks = [
  { href: '/bonusuri', label: 'Bonusuri' },
  { href: '/jocuri', label: 'Jocuri' },
  { href: '/sloturi', label: 'Sloturi' },
  { href: '/cazino-live', label: 'Cazino-Live' },
  { href: '/pariuri-sportive', label: 'Pariuri Sportive' },
];
---

<header class="absolute inset-x-0 top-0 z-10 px-4 py-3">
  <div class="max-w-6xl mx-auto grid grid-cols-3 items-center gap-4">
    <div class="justify-self-start">
      <button
        id="mobile-menu-toggle"
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-white/20 bg-black/30 text-white backdrop-blur-sm"
        aria-label="Deschide meniul principal"
        aria-controls="mobile-nav-menu"
        aria-expanded="false"
      >
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

    <div class="justify-self-center">
      <a href="/" class="inline-block">
        <img
          src="/images/logos/zinx-logo.svg"
          alt="Zinx Casino logo"
          width="80"
          height="40"
          loading="eager"
          class="h-10 w-auto"
        />
      </a>
    </div>

    <div class="justify-self-end">
      <a
        href={CTA_URL}
        rel="noopener noreferrer sponsored"
        target="_blank"
        class="inline-block font-bold text-sm px-4 py-2 rounded-full text-white transition-all duration-200 hover:scale-105 md:px-6 md:py-2.5"
        style="background: linear-gradient(90deg, #00d4ff, #7b2ff7); box-shadow: 0 0 20px rgba(0,212,255,0.3);"
      >
        Înregistrează
      </a>
    </div>
  </div>

  <nav
    id="mobile-nav-menu"
    class="hidden absolute left-4 right-4 top-full mt-2 rounded-xl border border-white/10 bg-[#080810]/95 p-4 backdrop-blur-md"
  >
    <div class="flex flex-col gap-3">
      {
        navLinks.map((link) => (
          <a href={link.href} class="text-sm font-medium text-gray-300 hover:text-white transition-colors">
            {link.label}
          </a>
        ))
      }
    </div>
  </nav>

  <script is:inline>
    const toggleButton = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-nav-menu');

    if (toggleButton && mobileMenu) {
      toggleButton.addEventListener('click', () => {
        const isExpanded = toggleButton.getAttribute('aria-expanded') === 'true';
        toggleButton.setAttribute('aria-expanded', String(!isExpanded));
        mobileMenu.classList.toggle('hidden');
      });
    }
  </script>
</header>

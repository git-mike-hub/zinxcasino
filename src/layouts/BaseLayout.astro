---
import '../styles/global.css';
import { DEFAULT_OG_IMAGE, SITE_NAME, absoluteUrl } from '../lib/seo';

const {
  title,
  description,
  canonicalURL,
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt = 'Zinx Casino România',
  schema = null,
  robots = 'index, follow',
} = Astro.props;

const canonicalPath =
  canonicalURL instanceof URL
    ? canonicalURL.pathname
    : (canonicalURL ?? Astro.url.pathname);
const canonical = absoluteUrl(canonicalPath);
const ogImageUrl = ogImage.startsWith('http') ? ogImage : absoluteUrl(ogImage);
---

<!DOCTYPE html>
<html lang="ro">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-6J45WERN55"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-6J45WERN55');
  </script>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#0a0a0f" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={robots} />

  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:alt" content={ogImageAlt} />
  <meta property="og:locale" content="ro_RO" />
  <meta property="og:site_name" content={SITE_NAME} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <meta name="twitter:image:alt" content={ogImageAlt} />

  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

  <link rel="sitemap" href="/sitemap-index.xml" />
</head>
<body class="text-white font-sans" style="background: #0a0a0f;">
  <slot />
</body>
</html>
